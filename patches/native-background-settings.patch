+/// Writing the settings file on every pointer move would rewrite it dozens of
+/// times per drag, so intermediate values are saved at most this often and the
+/// final value is saved when the pointer is released.
+const SLIDER_SAVE_INTERVAL: std::time::Duration = std::time::Duration::from_millis(150);
+
+#[derive(Default)]
+struct SliderDrag {
+    value: Option<f32>,
+    saved_value: Option<f32>,
+    last_saved_at: Option<std::time::Instant>,
+}
+
+/// Background values are fractions stored in 0..=1 (shown as percentages) except
+/// blur, which is stored in pixels.
+fn background_slider_range(json_path: &str) -> Option<(f32, &'static str)> {
+    match json_path {
+        "background.blur" => Some((30.0, "px")),
+        "background.image_opacity"
+        | "background.editor_opacity"
+        | "background.overlay_opacity"
+        | "background.surface_opacity"
+        | "background.message_opacity" => Some((1.0, "%")),
+        _ => None,
+    }
+}
+
+fn render_background_number_field(
+    field: SettingField<f32>,
+    file: SettingsUiFile,
+    metadata: Option<&SettingsFieldMetadata>,
+    title: &'static str,
+    description: &'static str,
+    window: &mut Window,
+    cx: &mut App,
+) -> AnyElement {
+    let Some((maximum, unit)) = field.json_path.and_then(background_slider_range) else {
+        return render_editable_number_field(field, file, metadata, title, description, window, cx);
+    };
+    let (_, value) = SettingsStore::global(cx).get_value_from_file(file.to_settings(), field.pick);
+    let value = value.copied().unwrap_or(0.0).clamp(0.0, maximum);
+    let scale = if maximum == 1.0 { 100.0 } else { 1.0 };
+    let numeric = NumberField::new(
+        format!("background-value-{title}"),
+        (value * scale * 100.0).round() / 100.0,
+        window,
+        cx,
+    )
+    .mode(NumberFieldMode::Edit, cx)
+    .tab_index(0_isize)
+    .aria_label(title)
+    .on_change({
+        let file = file.clone();
+        move |value, window, cx| {
+            let value = ((*value / scale).clamp(0.0, maximum) * 100.0).round() / 100.0;
+            update_settings_file(
+                file.clone(),
+                field.json_path,
+                window,
+                cx,
+                move |content, cx| {
+                    (field.write)(content, Some(value), cx);
+                },
+            )
+            .log_err();
+        }
+    })
+    .into_any_element();
+    let bounds = Rc::new(Cell::new(gpui::Bounds::<Pixels>::default()));
+    let drag = window.use_keyed_state(format!("background-slider-{title}"), cx, |_, _| {
+        SliderDrag::default()
+    });
+    let save = Rc::new(move |value: f32, window: &mut Window, cx: &mut App| {
+        update_settings_file(
+            file.clone(),
+            field.json_path,
+            window,
+            cx,
+            move |content, cx| {
+                (field.write)(content, Some(value), cx);
+            },
+        )
+        .log_err();
+    });
+    let change = Rc::new({
+        let bounds = bounds.clone();
+        let drag = drag.clone();
+        let save = save.clone();
+        move |position: gpui::Point<Pixels>, window: &mut Window, cx: &mut App| {
+            let bounds = bounds.get();
+            if bounds.size.width <= px(0.0) {
+                return;
+            }
+            let fraction = ((position.x - bounds.origin.x) / bounds.size.width).clamp(0.0, 1.0);
+            let value = (fraction * maximum * 100.0).round() / 100.0;
+            let should_save = drag.update(cx, |drag, cx| {
+                if drag.value == Some(value) {
+                    return false;
+                }
+                drag.value = Some(value);
+                cx.notify();
+                let due = drag
+                    .last_saved_at
+                    .is_none_or(|saved_at| saved_at.elapsed() >= SLIDER_SAVE_INTERVAL);
+                if due {
+                    drag.last_saved_at = Some(std::time::Instant::now());
+                    drag.saved_value = Some(value);
+                }
+                due
+            });
+            if should_save {
+                save(value, window, cx);
+            }
+        }
+    });
+    let finish = Rc::new({
+        let drag = drag.clone();
+        move |window: &mut Window, cx: &mut App| {
+            let pending = drag.update(cx, |drag, cx| {
+                let finished = std::mem::take(drag);
+                cx.notify();
+                finished
+                    .value
+                    .filter(|value| finished.saved_value != Some(*value))
+            });
+            if let Some(value) = pending {
+                save(value, window, cx);
+            }
+        }
+    });
+    let value = drag.read(cx).value.unwrap_or(value);
+    h_flex()
+        .gap_3()
+        .child(
+            div()
+                .id(format!("slider-{title}"))
+                .relative()
+                .w(px(180.0))
+                .h(px(24.0))
+                .cursor_pointer()
+                .child(
+                    div()
+                        .absolute()
+                        .top(px(10.0))
+                        .h(px(4.0))
+                        .w_full()
+                        .bg(cx.theme().colors().border),
+                )
+                .child(
+                    div()
+                        .absolute()
+                        .top(px(10.0))
+                        .h(px(4.0))
+                        .w(gpui::relative(value / maximum))
+                        .bg(cx.theme().colors().text_accent),
+                )
+                .child(
+                    gpui::canvas(
+                        move |track_bounds, _, _| bounds.set(track_bounds),
+                        |_, _, _, _| {},
+                    )
+                    .size_full(),
+                )
+                .on_mouse_down(gpui::MouseButton::Left, {
+                    let change = change.clone();
+                    move |event, window, cx| change(event.position, window, cx)
+                })
+                .on_mouse_move({
+                    let drag = drag.clone();
+                    move |event, window, cx| {
+                        if event.pressed_button == Some(gpui::MouseButton::Left)
+                            && drag.read(cx).value.is_some()
+                        {
+                            change(event.position, window, cx);
+                        }
+                    }
+                })
+                .on_mouse_up(gpui::MouseButton::Left, {
+                    let finish = finish.clone();
+                    move |_, window, cx| finish(window, cx)
+                })
+                .on_mouse_up_out(gpui::MouseButton::Left, move |_, window, cx| {
+                    if drag.read(cx).value.is_some() {
+                        finish(window, cx);
+                    }
+                }),
+        )
+        .child(numeric)
+        .child(Label::new(unit))
+        .into_any_element()
+}
+
 fn render_editable_number_field<T: NumberFieldType + Send + Sync>(
     field: SettingField<T>,
     file: SettingsUiFile,
